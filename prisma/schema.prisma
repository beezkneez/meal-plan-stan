generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth (NextAuth managed) ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts       Account[]
  sessions       Session[]
  schedule       Schedule?
  preferences    UserPreferences?
  calendarSyncs  CalendarSync[]
  recipes        Recipe[]
  mealPlans      MealPlan[]
  pantryItems      PantryItem[]
  apiKeys          ApiKey[]
  cartQueueItems   CartQueueItem[]
  adHocItems       AdHocItem[]
  shoppingListItems ShoppingListItem[]
  shoppingListExclusions ShoppingListExclusion[]
  googleTasksSync  GoogleTasksSync?

  // Household sharing
  householdId    String?
  householdMembers User[]           @relation("HouseholdMembers")
  householdOwner   User?            @relation("HouseholdMembers", fields: [householdId], references: [id])
  inviteTokens     HouseholdInvite[]
}

model HouseholdInvite {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ── User Preferences ──

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdSize       Int    @default(4)
  householdSizeWorkDay Int   @default(2) // how many eat at home when you're at work
  leftoverServings    Int    @default(2) // extra servings to pack as leftovers
  eatingStyle         String @default("balanced") // "balanced","healthy","bulking","budget","keto","family"
  // JSON arrays
  dislikes      String @default("[]") // ["mushrooms","olives",...]
  allergies     String @default("[]") // ["gluten","dairy","nuts",...]
  dietaryNeeds  String @default("[]") // ["high-protein","low-carb","vegetarian",...]

  preferQuickMeals  Boolean @default(false)
  preferSlowCooker  Boolean @default(false)
  preferLeftovers   Boolean @default(true)
  maxPrepMinutes    Int     @default(60)

  // UI preferences
  showMealImages    Boolean @default(true)

  // Weekly email
  emailEnabled      Boolean @default(false)
  emailDay          Int     @default(0)       // 0=Sun..6=Sat
  emailTime         String  @default("14:00") // 24h format

  // Pantry & navigation
  lowStockThreshold Float   @default(0.5)
  defaultPage       String  @default("/meal-plan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 16-Day Rotation ──

model Schedule {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON array of 16 entries: [{"day":0,"shift":"NIGHT"},{"day":1,"shift":"OFF"},...]
  pattern    String
  anchorDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Recipes ──

model Recipe {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  sourceUrl   String?
  imageUrl    String?

  prepMinutes  Int @default(0)
  cookMinutes  Int @default(0)
  totalMinutes Int @default(0)
  servings     Int @default(4)

  // Macros per serving
  calories Int?
  proteinG Int?
  carbsG   Int?
  fatG     Int?

  // JSON arrays
  ingredients String @default("[]")
  steps       String @default("[]")
  tags        String @default("[]")
  mealTypes   String @default("[\"dinner\"]") // ["breakfast","lunch","dinner","snack"]
  role        String @default("complete") // "complete","main","side","veggie","soup","salad"
  rating      Int    @default(0) // 0=unrated, 1-5 stars

  // Planner flags
  isQuick          Boolean @default(false)
  isSlowCook       Boolean @default(false)
  leftoverFriendly Boolean @default(true)

  mealSlots MealSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Meal Plans ──

model MealPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  slots     MealSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealSlot {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  date     DateTime
  mealType String   // "breakfast" | "lunch" | "dinner" | "snack"

  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id])

  servings             Int     @default(4)
  isLeftover           Boolean @default(false)
  leftoverSourceSlotId String?
  notes                String?
}

// ── Pantry ──

model PantryItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  category   String // "protein","dairy","grain","spice","oil","produce","frozen"
  unit       String // "lb","oz","count","bag"
  qtyOnHand  Float
  qtyMinimum Float @default(0)

  // Walmart.ca product linking
  walmartUrl             String?
  walmartUrlBackup       String?
  walmartPricePreference String @default("best_price") // "best_price" | "backup_when_oos"

  updatedAt DateTime @updatedAt
}

// ── API Keys (Chrome Extension auth) ──

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash   String    @unique
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

// ── Google Calendar Sync ──

model CalendarSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  googleCalendarId String // e.g. "primary", "abc123@group.calendar.google.com"
  calendarName     String
  color            String  @default("#4285f4")
  enabled          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, googleCalendarId])
}

// ── Cart Queue (Walmart auto-add-to-cart) ──

model CartQueueItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name    String
  qty     Float  @default(1)
  unit    String @default("")
  section String @default("") // grocery section

  walmartUrl       String?
  walmartUrlBackup String?
  source           String @default("meal_plan") // "meal_plan" | "google_tasks" | "manual"

  status     String  @default("pending") // "pending" | "added" | "failed" | "no_url"
  errorNote  String?
  usedBackup Boolean @default(false)

  weekOf    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, weekOf, status])
}

// ── Ad-Hoc Items (Google Tasks imports) ──

model AdHocItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  qty          Float   @default(1)
  unit         String  @default("")
  googleTaskId String?
  walmartUrl   String? // auto-matched from pantry
  imported     Boolean @default(false) // pulled into CartQueueItem?

  createdAt DateTime @default(now())
}

// ── Google Tasks Sync ──

model GoogleTasksSync {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  taskListId   String
  taskListName String
  enabled      Boolean @default(true)

  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// ── Shopping List Additions ──
// Items added straight to the shopping list without going through a meal plan,
// e.g. "add everything from this recipe". Meal-plan items are not stored here:
// they are derived from the plan's slots every time the list is built.

model ShoppingListItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name String
  qty  Float  @default(1)
  unit String @default("")

  source      String  @default("recipe") // "recipe" | "manual"
  recipeId    String?
  recipeTitle String? // kept denormalised so the list still reads well if the recipe is deleted

  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Shopping List Exclusions ──
// Meal-plan ingredients the user has cleared off the list. They cannot be
// deleted like stored items because they are recomputed from the plan's slots
// every load, so removal is recorded here instead. Scoped to one meal plan so
// clearing this week does not silently suppress the same item next time.
//
// Honoured by the shopping list AND the Walmart cart queue — a cleared item
// that still ended up in the cart would defeat the point of clearing it.

model ShoppingListExclusion {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  mealPlanId String
  nameKey    String // lowercased, trimmed ingredient name

  createdAt DateTime @default(now())

  @@unique([userId, mealPlanId, nameKey])
  @@index([userId, mealPlanId])
}
