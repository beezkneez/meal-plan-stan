generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Auth (NextAuth managed) ──

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?

  accounts       Account[]
  sessions       Session[]
  schedule       Schedule?
  preferences    UserPreferences?
  calendarSyncs  CalendarSync[]
  recipes        Recipe[]
  mealPlans      MealPlan[]
  pantryItems    PantryItem[]
  apiKeys        ApiKey[]

  // Household sharing
  householdId    String?
  householdMembers User[]           @relation("HouseholdMembers")
  householdOwner   User?            @relation("HouseholdMembers", fields: [householdId], references: [id])
  inviteTokens     HouseholdInvite[]
}

model HouseholdInvite {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
}

// ── User Preferences ──

model UserPreferences {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  householdSize       Int    @default(4)
  householdSizeWorkDay Int   @default(2) // how many eat at home when you're at work
  leftoverServings    Int    @default(2) // extra servings to pack as leftovers
  eatingStyle         String @default("balanced") // "balanced","healthy","bulking","budget","keto","family"
  // JSON arrays
  dislikes      String @default("[]") // ["mushrooms","olives",...]
  allergies     String @default("[]") // ["gluten","dairy","nuts",...]
  dietaryNeeds  String @default("[]") // ["high-protein","low-carb","vegetarian",...]

  preferQuickMeals  Boolean @default(false)
  preferSlowCooker  Boolean @default(false)
  preferLeftovers   Boolean @default(true)
  maxPrepMinutes    Int     @default(60)

  // UI preferences
  showMealImages    Boolean @default(true)

  // Weekly email
  emailEnabled      Boolean @default(false)
  emailDay          Int     @default(0)       // 0=Sun..6=Sat
  emailTime         String  @default("14:00") // 24h format

  // Pantry & navigation
  lowStockThreshold Float   @default(0.5)
  defaultPage       String  @default("/meal-plan")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── 16-Day Rotation ──

model Schedule {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // JSON array of 16 entries: [{"day":0,"shift":"NIGHT"},{"day":1,"shift":"OFF"},...]
  pattern    String
  anchorDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Recipes ──

model Recipe {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title       String
  sourceUrl   String?
  imageUrl    String?

  prepMinutes  Int @default(0)
  cookMinutes  Int @default(0)
  totalMinutes Int @default(0)
  servings     Int @default(4)

  // Macros per serving
  calories Int?
  proteinG Int?
  carbsG   Int?
  fatG     Int?

  // JSON arrays
  ingredients String @default("[]")
  steps       String @default("[]")
  tags        String @default("[]")
  mealTypes   String @default("[\"dinner\"]") // ["breakfast","lunch","dinner","snack"]
  role        String @default("complete") // "complete","main","side","veggie","soup","salad"
  rating      Int    @default(0) // 0=unrated, 1-5 stars

  // Planner flags
  isQuick          Boolean @default(false)
  isSlowCook       Boolean @default(false)
  leftoverFriendly Boolean @default(true)

  mealSlots MealSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ── Meal Plans ──

model MealPlan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  startDate DateTime
  endDate   DateTime
  slots     MealSlot[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MealSlot {
  id         String   @id @default(cuid())
  mealPlanId String
  mealPlan   MealPlan @relation(fields: [mealPlanId], references: [id], onDelete: Cascade)

  date     DateTime
  mealType String   // "breakfast" | "lunch" | "dinner" | "snack"

  recipeId String?
  recipe   Recipe? @relation(fields: [recipeId], references: [id])

  servings             Int     @default(4)
  isLeftover           Boolean @default(false)
  leftoverSourceSlotId String?
  notes                String?
}

// ── Pantry ──

model PantryItem {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  category   String // "protein","dairy","grain","spice","oil","produce","frozen"
  unit       String // "lb","oz","count","bag"
  qtyOnHand  Float
  qtyMinimum Float @default(0)

  // Walmart.ca product linking
  walmartUrl             String?
  walmartUrlBackup       String?
  walmartPricePreference String @default("best_price") // "best_price" | "backup_when_oos"

  updatedAt DateTime @updatedAt
}

// ── API Keys (Chrome Extension auth) ──

model ApiKey {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyHash   String    @unique
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
}

// ── Google Calendar Sync ──

model CalendarSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  googleCalendarId String // e.g. "primary", "abc123@group.calendar.google.com"
  calendarName     String
  color            String  @default("#4285f4")
  enabled          Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, googleCalendarId])
}
