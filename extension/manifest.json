{
  "manifest_version": 3,
  "name": "Meal Plan Stan - Add to Pantry",
  "description": "Quickly add Walmart.ca products to your Meal Plan Stan pantry",
  "version": "1.0.0",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.walmart.ca/*"],
  "content_scripts": [
    {
      "matches": ["https://www.walmart.ca/ip/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
