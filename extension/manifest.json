{
  "manifest_version": 3,
  "name": "Meal Plan Stan - Pantry & Cart",
  "description": "Add Walmart.ca products to your pantry and auto-fill your Walmart cart from your meal plan",
  "version": "2.0.0",
  "permissions": ["storage", "activeTab", "tabs", "scripting"],
  "host_permissions": ["https://www.walmart.ca/*"],
  "content_scripts": [
    {
      "matches": ["https://www.walmart.ca/ip/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
